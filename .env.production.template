# ==============================================================
# Casa Interior — Production Environment Template
# Copy to .env and fill in ALL values before deploying.
#
# Generate JWT_SECRET:
#   openssl rand -base64 64
#
# Generate MYSQL_ROOT_PASSWORD:
#   openssl rand -base64 32
# ==============================================================

# ── MySQL ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_NAME=casa_interior_db
DB_USERNAME=casauser
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── JWT ────────────────────────────────────────────────────────
# Minimum 32 bytes (256 bits) when decoded from Base64.
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_base64_encoded_secret_minimum_32_bytes_when_decoded

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated. Must match the exact origin (protocol + domain + port).
# No trailing slash. No wildcards.
CORS_ORIGINS=https://yourdomain.com

# ── Cloudinary (Cloud Media Storage) ──────────────────────────
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
